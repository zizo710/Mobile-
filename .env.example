# Copy to .env (which is git-ignored) and fill in. Never commit or share the key.

# "testnet" or "mainnet". Start on testnet.
HL_NETWORK=testnet

# Your main wallet's public address (0x...), the account that holds the funds.
HL_ACCOUNT_ADDRESS=

# Private key of an API wallet created at app.hyperliquid.xyz/API
# (testnet: app.hyperliquid-testnet.xyz/API). It can trade but cannot withdraw.
# Do NOT put your main wallet's private key or seed phrase here.
HL_API_WALLET_KEY=

# Optional overrides (defaults shown)
# HL_COIN=BTC
# HL_INTERVAL=4h
# HL_BUDGET_USD=10
# HL_LEVERAGE=2
# HL_MAX_LOSS_USD=3
# HL_ALLOW_SHORT=true
